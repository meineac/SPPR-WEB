<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WEB.UI.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <div class="container">
            <nav class="navbar bg-dark navbar-expand-md border-bottom" data-bs-theme="dark">

                <!-- Menu -->

                <a class="navbar-brand" href="#">WebProject</a>
                <div class="navbar-nav">
                    <a class="nav-item nav-link active" href="#">Lr1</a>
                    <a class="nav-item nav-link" href="#">Catalog</a>
                    <a class="nav-item nav-link" href="#">Admin</a>
                </div>

                <!-- User information -->
                <div class="d-flex align-items-center ms-auto">
                    <a href="#" class="navbar-text">
                        00,0 руб <i class="bi bi-cart"></i> (0)
                    </a>

                    <div class="dropdown ms-4 nav-color">
                        <button class="btn btn-secondary dropdown-toggle d-flex align-items-center gap-2"
                                type="button"
                                id="dropdownMenuButton"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">
                            <span>user@gmail.com</span>
                            <i class="bi bi-person-circle nav-color" style="font-size: 30px;"></i>
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                            <li>
                                <span class="dropdown-item-text">
                                    <i class="bi bi-person-circle nav-color" style="font-size: 50px;"></i>
                                    user@gmail.com
                                </span>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form id="logoutForm" class="form-inline" method="post">
                                    <button id="logout" type="submit" class="dropdown-item">Logout</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        </div>
    </header>
    <main class="container">
        @RenderBody()
    </main>
    <footer>
        <div class="container">
            <div class="navbar bg-dark navbar-expand-md border-bottom border-body"
                 data-bs-theme="dark">
                <div class="navbar-nav ms-auto">
                    <a class="nav-item nav-link" href="http://www.facebook.com">
                        <i class="bi bi-facebook" style="font-size: 2rem"></i>
                    </a>
                    <a class="nav-item nav-link" href="http://www.x.com">
                        <i class="bi bi-twitter-x" style="font-size: 2rem"></i>
                    </a>
                    <a class="nav-item nav-link" href="http://www.telegram.org">
                        <i class="bi-telegram" style="font-size: 2rem"></i>
                    </a>
                </div>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
